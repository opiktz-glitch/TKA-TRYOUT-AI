# Salin file ini menjadi ".env" lalu isi nilai sebenarnya.
# JANGAN pernah commit file ".env" (sudah di-exclude di .gitignore).

# Opsional. Kalau dikosongkan/dihapus, otomatis fallback ke
# database/project_tz.db (lihat config.py).
DATABASE_URL=

# WAJIB diisi. Generate dengan salah satu cara berikut lalu
# tempel hasilnya di sini (jangan pakai contoh/placeholder ini
# di environment production):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Daftar origin frontend yang diizinkan mengakses API ini,
# dipisah koma (TANPA spasi setelah koma, tanpa trailing slash).
# Dev lokal (Vite): boleh dikosongkan, otomatis fallback ke
# http://localhost:5173,http://127.0.0.1:5173 (lihat config.py).
# Production: WAJIB diisi domain asli, contoh:
#   CORS_ORIGINS=https://tryout.sekolahku.id,https://admin.sekolahku.id
CORS_ORIGINS=
