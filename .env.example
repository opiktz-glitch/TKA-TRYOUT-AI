# =========================================================
# Konfigurasi untuk docker-compose.yml (BUKAN backend/.env atau
# frontend/.env — dua file itu urusannya beda, lihat masing-masing
# folder untuk contohnya).
#
# Cara pakai:
#   cp .env.example .env
#   (isi VITE_API_URL di bawah, lalu jalankan)
#   docker compose up -d --build
# =========================================================

# URL API backend yang bisa diakses oleh BROWSER PENGGUNA (bukan
# oleh container itu sendiri). Nilai ini di-"bake" ke dalam file JS
# hasil build frontend SAAT BUILD (build-time), bukan dibaca saat
# container jalan — jadi mengubah nilai ini SETELAH build tidak
# akan berpengaruh sampai kamu build ulang (`docker compose up -d
# --build`, bukan cuma `docker compose restart`).
#
# - Untuk uji coba/testing DI LAPTOP SENDIRI: boleh dibiarkan
#   "http://localhost:8000" (nilai default kalau baris ini tidak
#   diisi sama sekali).
# - Untuk deploy ke SERVER/DOMAIN PRODUKSI: WAJIB diganti ke domain
#   API yang sesungguhnya, bisa diakses dari perangkat siswa/guru
#   (bukan "localhost" — di perangkat mereka, "localhost" berarti
#   perangkat mereka sendiri, bukan server kamu).
#
# Contoh production:
# VITE_API_URL=https://api.tka-ai.sekolahku.id
VITE_API_URL=http://localhost:8000
